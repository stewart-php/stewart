# Copy to .env (`make setup` does) and fill in; .env is gitignored and must never be committed.
# Any stewart.yaml setting can be set here: STEWART_, then the keys uppercased and joined by a double underscore.
# A setting ending in _FILE is read from that file instead, such as STEWART_HOME_ASSISTANT__TOKEN_FILE=/run/secrets/ha.

# A network address of Home Assistant; http(s):// is accepted as well.
STEWART_HOME_ASSISTANT__URL=ws://homeassistant.local:8123/api/websocket

# Profile -> Security -> Long-lived access tokens, in the Home Assistant UI.
STEWART_HOME_ASSISTANT__TOKEN=

# Storage for what must survive a restart; "valkey" is the service in compose.yaml.
STEWART_PERSISTENCE__URL=redis://valkey:6379/0

# MQTT server apps exchange messages with; unset leaves MQTT off. Credentials go in the URL: mqtt://user:pass@host.
# STEWART_MQTT__URL=mqtt://mosquitto:1883

# Shared secret for `make status`; `openssl rand -hex 16` makes one.
STEWART_CONTROL__TOKEN=

# debug | info | notice | warning | error
STEWART_LOG_LEVEL=info

# Read by the image entrypoint, not by Stewart: auto | always | never
# STEWART_BOOT_COMPOSER=auto
# 1 regenerates the entity and service classes from Home Assistant on every start.
# STEWART_BOOT_GENERATE=0
