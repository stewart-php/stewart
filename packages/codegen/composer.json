{
    "name": "stewart-php/codegen",
    "description": "Generates typed entity and service classes from a Home Assistant instance",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/stewart-php/stewart",
    "support": {
        "issues": "https://github.com/stewart-php/stewart/issues",
        "source": "https://github.com/stewart-php/stewart",
        "docs": "https://stewart-php.github.io/docs/"
    },
    "require": {
        "php": ">=8.5.12",
        "ext-ctype": "*",
        "ext-json": "*",
        "nette/php-generator": "^4.2.2",
        "psr/log": "^3.0",
        "stewart-php/client": "self.version",
        "stewart-php/contracts": "self.version",
        "stewart-php/runtime": "self.version",
        "stewart-php/support": "self.version",
        "symfony/console": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/string": "^7.4 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "stewart-php/testing": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Stewart\\Codegen\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Stewart\\Codegen\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.x-dev"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    }
}
