{
    "name": "stewart-php/testing",
    "description": "Test Stewart apps without Home Assistant: an app harness, recording fakes and virtual time",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/stewart-php/stewart",
    "support": {
        "issues": "https://github.com/stewart-php/stewart/issues",
        "source": "https://github.com/stewart-php/stewart",
        "docs": "https://stewart-php.github.io/docs/"
    },
    "require": {
        "php": ">=8.5",
        "amphp/amp": "^3.1.1",
        "amphp/byte-stream": "^2.1",
        "amphp/http-client": "^5.3",
        "amphp/socket": "^2.4",
        "amphp/websocket": "^2.0.4",
        "amphp/websocket-client": "^2.0.2",
        "phpunit/phpunit": "^13.3",
        "psr/log": "^3.0",
        "stewart-php/contracts": "self.version",
        "stewart-php/store": "self.version",
        "stewart-php/support": "self.version"
    },
    "conflict": {
        "amphp/cache": "<2.0.1",
        "amphp/dns": "<2.2",
        "daverandom/libdns": "<2.1"
    },
    "autoload": {
        "psr-4": {
            "Stewart\\Testing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Stewart\\Testing\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    }
}
