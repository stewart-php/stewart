{
    "name": "stewart-php/phpstan",
    "description": "PHPStan rules that check Home Assistant entity IDs and action names against a Stewart project's generated classes",
    "type": "phpstan-extension",
    "license": "MIT",
    "homepage": "https://github.com/stewart-php/stewart",
    "support": {
        "issues": "https://github.com/stewart-php/stewart/issues",
        "source": "https://github.com/stewart-php/stewart",
        "docs": "https://stewart-php.github.io/docs/"
    },
    "require": {
        "php": ">=8.5.12",
        "composer-runtime-api": "^2.2",
        "phpstan/phpstan": "^2.3",
        "stewart-php/contracts": "self.version",
        "stewart-php/support": "self.version"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "Stewart\\PHPStan\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Stewart\\PHPStan\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.x-dev"
        },
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        }
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    }
}
