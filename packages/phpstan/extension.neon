parameters:
    stewart:
        manifest: App\Generated\Manifest

parametersSchema:
    stewart: structure([
        manifest: string()
    ])

services:
    - Stewart\Support\Text\ClosestNameFinder
    - Stewart\PHPStan\Rule\EntityIdLiterals
    - Stewart\PHPStan\Rule\TestCodeScope
    -
        class: Stewart\PHPStan\Manifest\ManifestCatalogLoader
        arguments:
            manifestClass: %stewart.manifest%
    - Stewart\PHPStan\Manifest\GeneratedHandles
    -
        class: Stewart\PHPStan\Cache\ManifestResultCacheValue
        tags:
            - phpstan.resultCacheValueExtension
    -
        class: Stewart\PHPStan\Collector\GeneratedCodeFromOlderMajorCollector
        tags:
            - phpstan.collector

rules:
    - Stewart\PHPStan\Rule\EntityIdArgumentRule
    - Stewart\PHPStan\Rule\ActionNameArgumentRule
    - Stewart\PHPStan\Rule\GeneratedCodeFromOlderMajorRule
