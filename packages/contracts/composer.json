{
    "name": "stewart-php/contracts",
    "description": "Stewart core abstractions. Pure PHP",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/stewart-php/stewart",
    "support": {
        "issues": "https://github.com/stewart-php/stewart/issues",
        "source": "https://github.com/stewart-php/stewart",
        "docs": "https://stewart-php.github.io/docs/"
    },
    "require": {
        "php": ">=8.5.12",
        "ext-filter": "*"
    },
    "require-dev": {
        "amphp/amp": "^3.1.1",
        "phpunit/phpunit": "^13.3",
        "stewart-php/testing": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Stewart\\Contracts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Stewart\\Contracts\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.x-dev"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    }
}
