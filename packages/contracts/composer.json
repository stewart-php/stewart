{
    "name": "stewart-php/contracts",
    "description": "Stewart core abstractions. Pure PHP and one cron parser",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "dragonmantank/cron-expression": "^3.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "stewart-php/testing": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Stewart\\Contracts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Stewart\\Contracts\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.x-dev"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    }
}
