{
    "name": "stewart-php/support",
    "description": "Framework-internal helpers shared by the Stewart packages. Not part of the app-facing API",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/stewart-php/stewart",
    "support": {
        "issues": "https://github.com/stewart-php/stewart/issues",
        "source": "https://github.com/stewart-php/stewart",
        "docs": "https://stewart-php.github.io/docs/"
    },
    "require": {
        "php": ">=8.5.12",
        "ext-json": "*",
        "amphp/amp": "^3.1.1",
        "dragonmantank/cron-expression": "^3.4",
        "revolt/event-loop": "^1.0.9",
        "stewart-php/contracts": "self.version"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "stewart-php/testing": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Stewart\\Support\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Stewart\\Support\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.x-dev"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    }
}
