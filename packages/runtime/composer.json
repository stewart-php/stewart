{
    "name": "stewart-php/runtime",
    "description": "Stewart broker, workers and the channel protocol between them.",
    "type": "library",
    "license": "MIT",
    "bin": [
        "bin/stewart"
    ],
    "require": {
        "php": ">=8.5",
        "amphp/amp": "^3.1.1",
        "amphp/byte-stream": "^2.1",
        "amphp/parallel": "^2.4",
        "amphp/socket": "^2.4",
        "amphp/sync": "^2.3",
        "composer-runtime-api": "^2.2",
        "ext-ctype": "*",
        "ext-json": "*",
        "ext-pcntl": "*",
        "monolog/monolog": "^3.12",
        "psr/log": "^3.0",
        "revolt/event-loop": "^1.0.9",
        "stewart-php/client": "self.version",
        "stewart-php/contracts": "self.version",
        "stewart-php/store": "self.version",
        "stewart-php/support": "self.version",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/console": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/dotenv": "^7.4 || ^8.0",
        "symfony/filesystem": "^7.4 || ^8.0",
        "symfony/finder": "^7.4 || ^8.0",
        "symfony/process": "^7.4 || ^8.0",
        "symfony/yaml": "^7.4 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "psr/container": "^2.0",
        "stewart-php/store-redis": "self.version",
        "stewart-php/testing": "self.version"
    },
    "conflict": {
        "amphp/process": "<2.0.3"
    },
    "suggest": {
        "stewart-php/codegen": "Adds the generate command, for development or for generating when a container starts"
    },
    "autoload": {
        "psr-4": {
            "Stewart\\Runtime\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Stewart\\Runtime\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.x-dev"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    }
}
