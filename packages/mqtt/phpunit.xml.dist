<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true"
         cacheDirectory="var/phpunit">
    <testsuites>
        <!-- No Home Assistant, no external services. -->
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <!-- Real sockets, against a fake MQTT server in the test process. -->
        <testsuite name="integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <!-- Needs the mosquitto service, not Home Assistant. -->
        <testsuite name="persistence">
            <directory>tests/Persistence</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
    <php>
        <ini name="memory_limit" value="512M"/>
        <env name="TEST_MQTT_URL" value="mqtt://mosquitto:1883"/>
    </php>
</phpunit>
