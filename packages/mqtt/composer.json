{
    "name": "stewart-php/mqtt",
    "description": "MQTT 3.1.1 client that connects Stewart apps to an MQTT server. Non-blocking, over amphp",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "amphp/amp": "^3.1.1",
        "amphp/byte-stream": "^2.1",
        "amphp/socket": "^2.4",
        "psr/log": "^3.0",
        "stewart-php/contracts": "self.version",
        "stewart-php/runtime": "self.version",
        "stewart-php/support": "self.version",
        "symfony/dependency-injection": "^7.4 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "stewart-php/testing": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Stewart\\Mqtt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Stewart\\Mqtt\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.x-dev"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    }
}
