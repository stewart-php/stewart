{
    "name": "stewart-php/store",
    "description": "Scoping, encoding and hydration for Stewart's key-value storage. Backend-agnostic",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/stewart-php/stewart",
    "support": {
        "issues": "https://github.com/stewart-php/stewart/issues",
        "source": "https://github.com/stewart-php/stewart",
        "docs": "https://stewart-php.github.io/docs/"
    },
    "require": {
        "php": ">=8.5",
        "ext-json": "*",
        "stewart-php/contracts": "self.version",
        "stewart-php/support": "self.version"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "stewart-php/testing": "self.version"
    },
    "suggest": {
        "stewart-php/store-redis": "A Redis backend, the only one shipped today"
    },
    "autoload": {
        "psr-4": {
            "Stewart\\Store\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Stewart\\Store\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    }
}
