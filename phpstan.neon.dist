includes:
    - vendor/phpat/phpat/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon

parameters:
    level: max
    paths:
        - packages/contracts/src
        - packages/support/src
        - packages/client/src
        - packages/store/src
        - packages/store-redis/src
        - packages/mqtt/src
        - packages/sun/src
        - packages/codegen/src
        - packages/runtime/src
        - packages/testing/src
        - packages/contracts/tests
        - packages/support/tests
        - packages/client/tests
        - packages/store/tests
        - packages/store-redis/tests
        - packages/mqtt/tests
        - packages/sun/tests
        - packages/codegen/tests
        - packages/runtime/tests
        - packages/testing/tests
        - packages/runtime/bin
        - packages/runtime/config
        - packages/codegen/config
        - packages/store-redis/config
        - packages/mqtt/config
        - packages/runtime/bin/stewart
        - tests
    tmpDir: var/phpstan
    treatPhpDocTypesAsCertain: false
    checkExplicitMixed: true
    strictRules:
        disallowedShortTernary: false
    phpat:
        ignore_built_in_classes: true
    ignoreErrors:
        # The point of the fixture: an app written against classes nobody has generated yet.
        -
            identifier: class.notFound
            path: packages/runtime/tests/Fixtures/Container/NeedsMissingClass.php
        # PHP 8 no longer deprecates casting a ReflectionType to string.
        -
            identifier: class.toStringDeprecated
            path: packages/runtime/src/Json/ClassShapeReader.php
        # The mapper reads DTO properties by their wire field names.
        -
            identifier: property.dynamicName
            path: packages/runtime/src/Json/WireMapper.php
        # amphp's WebsocketClient narrows the onClose closure it inherits from Closable.
        -
            identifier: method.childParameterType
            path: packages/testing/src/Websocket/FakeWebsocketConnection.php
        # Assertions narrow values that captured closures or event-loop callbacks change afterwards.
        -
            identifier: staticMethod.impossibleType
            paths:
                - packages/runtime/tests/Unit/Broker/BrokerLifecycleTest.php
                - packages/runtime/tests/Unit/Dispatch/LocalDispatcherTest.php
                - packages/support/tests/Unit/Time/RevoltTimersTest.php
        -
            identifiers:
                - offsetAccess.notFound
                - method.nonObject
            path: packages/runtime/tests/Unit/Schedule/ScheduleRegistryTest.php
        # Fails when the committed fixture's format falls behind the generator.
        -
            identifier: staticMethod.alreadyNarrowedType
            path: packages/codegen/tests/Unit/GeneratedCodeBehaviorTest.php

services:
    -
        class: Stewart\Tests\Architecture\PackageDependencyRules
        tags:
            - phpat.test
    -
        class: Stewart\Tests\Architecture\ExceptionModelRules
        tags:
            - phpat.test

rules:
    - Stewart\Tests\Architecture\ThrowsStewartExceptionsRule
    - Stewart\Tests\Architecture\NoRawClockReadRule
    - Stewart\Tests\Architecture\NoRawTimeValueRule
    - Stewart\Tests\Architecture\MethodNameRule
    - Stewart\Tests\Architecture\TypedCollectionRule
