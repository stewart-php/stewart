<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true"
         cacheDirectory="var/phpunit">
    <testsuites>
        <!-- No Home Assistant, no external services. -->
        <testsuite name="unit">
            <directory>packages/*/tests/Unit</directory>
        </testsuite>
        <!-- Smoke tests over real worker processes and the valkey service; not Home Assistant. -->
        <testsuite name="process">
            <directory>packages/*/tests/Process</directory>
        </testsuite>
        <!-- Needs the valkey service, not Home Assistant. -->
        <testsuite name="persistence">
            <directory>packages/*/tests/Persistence</directory>
        </testsuite>
        <!-- Real sockets across packages in one process; no Home Assistant. -->
        <testsuite name="integration">
            <directory>packages/*/tests/Integration</directory>
            <directory>tests/Integration</directory>
        </testsuite>
        <!-- Repository-wide guards; monorepo only. -->
        <testsuite name="architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>packages/contracts/src</directory>
            <directory>packages/support/src</directory>
            <directory>packages/client/src</directory>
            <directory>packages/codegen/src</directory>
            <directory>packages/store/src</directory>
            <directory>packages/store-redis/src</directory>
            <directory>packages/mqtt/src</directory>
            <directory>packages/runtime/src</directory>
        </include>
    </source>
    <php>
        <ini name="memory_limit" value="512M"/>
        <env name="TEST_STORE_URL" value="redis://valkey:6379/15"/>
        <env name="TEST_MQTT_URL" value="mqtt://mosquitto:1883"/>
    </php>
</phpunit>
